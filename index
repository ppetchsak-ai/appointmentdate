 reportText=['สรุปวันนัดคลินิก',unit,'วันที่เริ่มจ่ายยา: '+thaiDate($('start').value),`${drug}: ${num(dose)} เม็ด/วัน · คงเหลือ ${num(remaining)} เม็ด`,...(insulin?[`Insulin ${num(insulinDaily)} units/วัน · ${num($('capacity').value)} units/หลอด · คงเหลือ ${num($('ir').value)} units`]:[]),'',...rows.map(r=>`${r.g+1} เดือน · ตัวเลือก ${r.id%3+1} | ${thaiDate(r.date)} | ${r.clinic} | จริง ${r.days} วัน | จัดยา ${r.supply} วัน | จ่าย ${r.qty} เม็ด${insulin?' | Insulin '+r.insulinQty+' หลอด':''}`),'', $('reportRule').textContent,'แต่ละแถวเป็นตัวเลือกอิสระ ไม่รวมจำนวนยาข้ามรายการ',...(insulin?[$('insulinNote').textContent]:[])].filter(x=>x!==undefined).join('\n');
}
