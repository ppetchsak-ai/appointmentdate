</main><script>
'use strict';
const $=id=>document.getElementById(id);
const CLINICS=['DM','HT','Asthma','warfarin'];
const BASES=[40,70,90];
const DAY=86400000;
function parseDate(value){if(!/^\d{4}-\d{2}-\d{2}$/.test(value||''))return null;const [y,m,d]=value.split('-').map(Number);if(y<1900||y>9999)return null;const t=new Date(Date.UTC(y,m-1,d));return t.getUTCFullYear()===y&&t.getUTCMonth()===m-1&&t.getUTCDate()===d?t:null;}
function daysBetween(a,b){const x=parseDate(a),y=parseDate(b);return x&&y?(y-x)/DAY:null;}
function round10(n){return Math.ceil(Math.max(0,n)/10)*10;}
function supplyDays(days,base){return days<=base?base:round10(days);}
function tablets(days,dose,remaining){return round10(days*dose-remaining);}
function containers(days,dose,remaining,capacity){return Math.ceil(Math.max(0,days*dose-remaining)/capacity);}
function esc(v){return String(v).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
const num=n=>Number(n).toLocaleString('th-TH',{maximumFractionDigits:2});
function thaiDate(value){const d=parseDate(value);return d?new Intl.DateTimeFormat('th-TH',{weekday:'short',day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}).format(d):'—';}
function today(){const d=new Date();return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
let reportText='';
$('groups').innerHTML=BASES.map((base,g)=>`<section class="group"><div class="group-head"><div><div class="month">${g+1} เดือน</div><span class="small muted">เลือกได้ 3 วันนัด</span></div><span class="base">ฐานจัดยา <strong>${base}</strong> วัน</span></div>${[0,1,2].map(s=>{const id=g*3+s;return `<article class="slot off" data-id="${id}" data-group="${g}"><div class="slot-line"><label><input type="checkbox" id="use${id}" class="use">ใช้วันนัดที่ ${s+1}</label><button class="clear" type="button" aria-label="ล้างวันนัด ${g+1} เดือน ตัวเลือก ${s+1}">ล้าง</button></div><div class="fields"><div><label for="date${id}">วันที่นัด</label><input type="date" id="date${id}" class="date"></div><div><label for="clinic${id}">คลินิก</label><select id="clinic${id}" class="clinic-select"><option value="">เลือกคลินิก</option>${CLINICS.map((c,i)=>`<option value="${c}">${i+1}. ${c}</option>`).join('')}</select></div></div><p class="slot-result" id="result${id}">ยังไม่เลือกวันนัด</p></article>`;}).join('')}</section>`).join('');
function validNumber(id,required=true){const e=$(id);const ok=(!required&&e.value==='')||(e.value.trim()!==''&&Number.isFinite(e.valueAsNumber)&&e.validity.valid);e.setAttribute('aria-invalid',String(!ok));return ok;}
function recalc(){
 const errors=[],rows=[];let selected=0;
 const startOk=!!parseDate($('start').value);$('start').setAttribute('aria-invalid',String(!startOk));if(!startOk)errors.push('กรุณาระบุวันที่เริ่มจ่ายยาให้ถูกต้อง');
 const doseOk=validNumber('daily'),remainingOk=validNumber('remaining');if(!doseOk)errors.push('ขนาดยาเม็ดต้องอยู่ระหว่าง 0.25–1,000 เม็ด/วัน และเพิ่มครั้งละ 0.25');if(!remainingOk)errors.push('ยาคงเหลือต้องเป็น 0–1,000,000 เม็ด และเพิ่มครั้งละ 0.25');
 const insulin=$('insulinEnabled').checked;let insulinOk=true;const ids=['im','in','ie','ib','ir'];ids.forEach(id=>{if(insulin){if(!validNumber(id))insulinOk=false;}else $(id).removeAttribute('aria-invalid');});const insulinDaily=['im','in','ie','ib'].reduce((a,id)=>a+Number($(id).value),0);if(insulin&&(!insulinOk||insulinDaily<=0)){errors.push('กรอก Insulin รวมมากกว่า 0 แต่ละช่วงไม่เกิน 500 units และคงเหลือไม่ติดลบ (เพิ่มครั้งละ 0.5)');insulinOk=false;}
